# MongoDB local example: mongodb://127.0.0.1:27017/athletix
# MongoDB Atlas: use the connection string from your Atlas cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/athletix
PORT=4000
# Comma-separated origins allowed to call this API from a browser.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_COOKIE_NAME=athletix.sid
SESSION_MAX_AGE_MS=28800000
SESSION_SAME_SITE=lax
TRUST_PROXY_HOPS=0
