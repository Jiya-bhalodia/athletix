{
  "name": "athletix-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --test-concurrency=1 src/app.test.ts src/test/models.test.ts src/test/config.test.ts src/test/auth.test.ts src/test/api.test.ts src/test/errors.test.ts src/test/fee-balances.test.ts",
    "seed:dev": "tsx src/seed/run.ts",
    "auth:provision-admin": "tsx src/cli/provision-admin.ts",
    "auth:provision-account": "tsx src/cli/provision-role-account.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "argon2": "^0.41.1",
    "connect-mongo": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^22.16.5",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
